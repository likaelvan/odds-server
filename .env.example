# Copy this file to ".env" and fill in your key from https://the-odds-api.com
ODDS_API_KEY=

# Bookmaker regions to pull: us, uk, eu, au (comma-separated).
# Each region costs 1 credit per tournament you load. Free plan = 500 credits/month.
ODDS_REGIONS=eu,uk

# Reuse fetched odds for this many minutes before spending credits again.
CACHE_MINUTES=10

PORT=8765

# --- Player stats (py update_stats.py) ---
# First season of results to download (used for head-to-head)
STATS_SINCE=2015
# Ranking history used for career-high rank: 00s, 10s, 20s (older decades = bigger download)
STATS_RANKING_DECADES=10s,20s
# Optional: download the same CSV files from somewhere else (must end with /)
# STATS_ATP_URL=https://huggingface.co/datasets/Aneeshers/tennis-sackmann-archive/resolve/main/atp/
# STATS_WTA_URL=https://huggingface.co/datasets/Aneeshers/tennis-sackmann-archive/resolve/main/wta/
# Look up current / career-high rank on Wikipedia when showing player stats (1 = on, 0 = off)
LIVE_RANKS=1
